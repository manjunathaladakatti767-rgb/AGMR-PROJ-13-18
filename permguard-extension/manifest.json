{
  "manifest_version": 3,
  "name": "AccessShield Browser Guard",
  "version": "1.0",
  "description": "Automatically scans URLs you visit and stores them in your AccessShield Dashboard.",
  "permissions": ["tabs", "storage", "activeTab", "scripting"],
  "host_permissions": ["http://localhost:5000/*", "http://localhost:5001/*", "<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
